# Copie para .env (na mesma pasta do docker-compose.yml) e preencha.
# Gerar segredo: openssl rand -base64 48

# Dominio apontando (registro A) para o IP da VPS
DOMAIN=app.analisandoia.com.br

# Banco: Supabase (conexao direta, porta 5432; a VPS tem IPv6)
DB_URL=jdbc:postgresql://db.gbzmribcjrgxvzbibcqp.supabase.co:5432/postgres?sslmode=require
DB_USERNAME=postgres
DB_PASSWORD=TROQUE

APP_JWT_SECRET=TROQUE_POR_SEGREDO_LONGO

# URL publica do FRONT (Vercel) e origens CORS permitidas
APP_PUBLIC_BASE_URL=https://sindico-seven.vercel.app
APP_CORS_ORIGINS=https://sindico-seven.vercel.app,https://www.wesleyoliveira.tech,https://wesleyoliveira.tech

# Segredo compartilhado com o middleware do Vercel (env PROXY_SHARED_SECRET no Vercel).
# Permite ao back-end enxergar o IP real do usuario (rate limit, aceite LGPD). Gerar: openssl rand -hex 32
APP_TRUSTED_PROXY_SECRET=

# Admin inicial (opcional)
APP_ADMIN_EMAIL=
APP_ADMIN_PASSWORD=

# Anexos: local (disco da VPS, volume "uploads") ou supabase (Supabase Storage)
APP_STORAGE_PROVIDER=local
SUPABASE_URL=https://gbzmribcjrgxvzbibcqp.supabase.co
SUPABASE_SERVICE_KEY=
SUPABASE_STORAGE_BUCKET=anexos

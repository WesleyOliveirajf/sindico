# Copie este arquivo para .env e preencha os valores reais
# O arquivo .env NÃO deve ser commitado no git

# Perfil Spring Boot ativo
SPRING_PROFILES_ACTIVE=supabase

# Supabase — conexão direta (porta 5432, não usar pooler transacional 6543 com Flyway)
# Projeto: https://supabase.com/dashboard/project/gbzmribcjrgxvzbibcqp
DB_URL=jdbc:postgresql://db.gbzmribcjrgxvzbibcqp.supabase.co:5432/postgres?sslmode=require
DB_USERNAME=postgres
DB_PASSWORD=TROQUE_PELA_SENHA_DO_DASHBOARD
# Se sua rede nao tiver IPv6 (a conexao direta do Supabase so responde por IPv6), use o Session Pooler:
# DB_URL=jdbc:postgresql://aws-0-<regiao>.pooler.supabase.com:5432/postgres?sslmode=require
# DB_USERNAME=postgres.gbzmribcjrgxvzbibcqp

# Storage de anexos: local (dev; na VPS, volume "uploads") | supabase (Supabase Storage)
APP_STORAGE_PROVIDER=local
# Necessarios apenas com APP_STORAGE_PROVIDER=supabase (bucket privado criado no dashboard)
SUPABASE_URL=https://gbzmribcjrgxvzbibcqp.supabase.co
SUPABASE_SERVICE_KEY=TROQUE_PELA_SERVICE_ROLE_KEY
SUPABASE_STORAGE_BUCKET=anexos

# Origens permitidas no CORS (separadas por vírgula)
APP_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Usuário admin da aplicação (opcional; o e-mail e lido de APP_ADMIN_EMAIL)
APP_ADMIN_EMAIL=admin@example.com
APP_ADMIN_PASSWORD=TROQUE_POR_UMA_SENHA_FORTE
